# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/

# Raw downloads and caches (rebuild with the pipeline, see data/README.md)
data/raw/

# Node (frontend, when it exists)
node_modules/
dist/
*.tsbuildinfo
.vite/

# Local tooling and secrets
.env
.env.*
.vercel/
.claude/settings.local.json
*.log

# Frontend static data: copied from data/ and built by web/scripts (npm run tiles), never committed
web/public/data/
web/public/tiles/
web/test-results/
web/playwright-report/
# local dev viewer (not part of the project)
viewer/

# Vercel deployment folder (deploy/vercel/stage.sh)
.vercel-stage/
.vercel/

# The demo video is served with the site but kept out of git (36 MB): copy demo.mp4 into web/public/media
web/public/media/*.mp4
