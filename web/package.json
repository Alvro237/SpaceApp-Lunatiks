{
  "name": "lunatiks-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "predev": "node scripts/copy_static_data.mjs",
    "dev": "vite",
    "prebuild": "node scripts/copy_static_data.mjs",
    "build": "tsc -b && vite build",
    "tiles": "uv run --project ../pipeline python scripts/build_preview_tiles.py",
    "gen:api": "uv run --project ../api python scripts/dump_openapi.py > node_modules/.openapi.json && npx --yes openapi-typescript@7.13.0 node_modules/.openapi.json -o src/api/schema.gen.ts",
    "lint": "oxlint",
    "typecheck": "tsc -b --noEmit",
    "pretest": "node scripts/copy_static_data.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@react-three/fiber": "^9.8.2",
    "@tanstack/react-query": "^5.107.1",
    "d3-scale": "^4.0.3",
    "d3-scale-chromatic": "^3.1.1",
    "d3-shape": "^3.2.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "three": "^0.187.0",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.10",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-scale-chromatic": "^3.1.0",
    "@types/d3-shape": "^3.2.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.1.2",
    "axe-core": "^4.14.0",
    "jsdom": "^29.1.1",
    "oxlint": "^1.90.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=22"
  }
}
